## launch.py
"""計測用: 裏の検査と書き出しを止め、全ての行の読み込みの開始と終了の時刻を記録して serve を起動する。"""

import json
import os
import sys
import threading
import time

from project_index import __main__ as entry
from project_index import main as main_module
from project_index.features.sources.registry import SourceRegistry

OUT = os.environ["MEASURE_LOAD_OUT"]


def no_checks(*args, **kwargs):
    thread = threading.Thread(target=lambda: None, daemon=True)
    thread.start()
    return thread


main_module.check_and_export_later = no_checks
original = SourceRegistry.load


def timed(self, terminal):
    started = time.time()
    original(self, terminal)
    with open(OUT, "w", encoding="utf-8") as file:
        json.dump({"start": started, "end": time.time()}, file)


SourceRegistry.load = timed
sys.argv = ["project-index", "serve"]
sys.exit(entry.main())

## run.sh
#!/bin/bash
# 使い方: run.sh {クローン} {名前} {api|load}
set -u
CLONE=$1; NAME=$2; MODE=$3
R=/tmp/pr171-measure/runs/$NAME; rm -rf "$R"; mkdir -p "$R/state" "$R/body"
SOURCES="dev-docs claude-balancer aituber knowledge mdmark ai-monitor voice-input gui-support mindstella observability project-index alias-inject rule-inject shuhdev-gateway"
cat /proc/loadavg > "$R/loadavg-before"
T0=$(date +%s.%N); echo "$T0" > "$R/t0"
MEASURE_LOAD_OUT="$R/load.json" PROJECT_INDEX_CONFIG=/tmp/poc171/pi-settings.yaml PROJECT_INDEX_PORT=18787 PROJECT_INDEX_STATE_DIR="$R/state" \
  "$CLONE/.venv/bin/python" /tmp/pr171-measure/launch.py > "$R/pi.log" 2>&1 &
PI=$!
until ss -ltn | grep -q "127.0.0.1:18787 "; do sleep 0.1; done
if [ "$MODE" = api ]; then
  sleep "$(python3 -c "import time;print(max(0,$T0+5-time.time()))")"
  for s in $SOURCES; do
    for n in 1 2; do
      curl -s -o "$R/body/$s-$n.json" -w "$s $n %{http_code} %{time_total}\n" \
        "http://127.0.0.1:18787/sources/$s/docs?values=true&common_keys=true" >> "$R/api.txt"
    done
  done
else
  until [ -f "$R/load.json" ]; do sleep 0.2; done
fi
cat /proc/loadavg > "$R/loadavg-after"
kill $PI; wait $PI 2>/dev/null
echo done "$R"

## analyze.py
import json, statistics, pathlib
R = pathlib.Path("/tmp/pr171-measure/runs")
def api(name):
    rows = {}
    for line in (R / name / "api.txt").read_text().splitlines():
        s, n, code, t = line.split()
        rows[(s, int(n))] = (code, float(t))
    return rows
def load(name):
    d = json.loads((R / name / "load.json").read_text())
    return d["end"] - d["start"]
runs = [1, 2, 3]
sources = [k[0] for k in api("before-api-1") if k[1] == 1]
print("| 配信元 | 回 | 前（中央値・秒） | 後（中央値・秒） | 比 | 前の 3 回 | 後の 3 回 |")
print("| --- | --- | --- | --- | --- | --- | --- |")
for s in sources:
    for n in (1, 2):
        b = [api(f"before-api-{i}")[(s, n)][1] for i in runs]
        a = [api(f"after-api-{i}")[(s, n)][1] for i in runs]
        codes = {api(f"after-api-{i}")[(s, n)][0] for i in runs} | {api(f"before-api-{i}")[(s, n)][0] for i in runs}
        mb, ma = statistics.median(b), statistics.median(a)
        print(f"| {s} | {n} | {mb:.2f} | {ma:.2f} | {ma/mb:.2f} | {' / '.join(f'{x:.2f}' for x in b)} | {' / '.join(f'{x:.2f}' for x in a)} |" + ("" if codes == {"200"} else f" codes={codes}"))
lb = [load(f"before-load-{i}") for i in runs]; la = [load(f"after-load-{i}") for i in runs]
print()
print(f"全ての行の読み込み: 前 {statistics.median(lb):.2f} 秒（{' / '.join(f'{x:.2f}' for x in lb)}）・後 {statistics.median(la):.2f} 秒（{' / '.join(f'{x:.2f}' for x in la)}）")
# 応答の一致（同じ回の前後で、値が同じか）
diff = []
for i in runs:
    for s in sources:
        b = json.loads((R / f"before-api-{i}" / "body" / f"{s}-1.json").read_text())
        a = json.loads((R / f"after-api-{i}" / "body" / f"{s}-1.json").read_text())
        if b != a:
            diff.append((i, s))
print("応答の不一致:", diff)
for i in runs:
    print(i, "load avg", (R / f"before-api-{i}" / "loadavg-before").read_text().split()[:3], (R / f"after-api-{i}" / "loadavg-before").read_text().split()[:3])
