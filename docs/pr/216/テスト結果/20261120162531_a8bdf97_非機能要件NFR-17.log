## 計測のスクリプト
"""NFR-17 の計測: スレッド 8 本で、ref を指した文書と ref を省いた文書の取得と直列化を交互に呼ぶ。"""
import os, sys, time, threading, statistics
from pathlib import Path
from project_index.features.settings.query import config_path, load_terminal_config
from project_index.main import build_handlers
from project_index.features.read.paths import read_target
from project_index.features.read import service as svc

LABEL = sys.argv[1]
ROUNDS = int(sys.argv[2])
REF = "c9cd618aa"
terminal = load_terminal_config(config_path(os.environ))
terminal = terminal.model_copy(update={"sources": [s for s in terminal.sources if s.id in ("ai-monitor", "knowledge")], "state_dir": Path(f"/tmp/pi215/state-{LABEL}")})
h = build_handlers(terminal)
h.registry.load(h.terminal)

def one(ref, path):
    t = time.perf_counter()
    target, _ = read_target("ai-monitor", ref, registry=h.registry)
    resp = svc.get_document(target, path, store=h.store, converter=h.converter)
    resp.model_dump_json(by_alias=True)
    return time.perf_counter() - t

one(None, "docs/data/DATA-3430-1.yaml"); one(REF, "docs/data/DATA-3694-1.yaml")
stop = threading.Event()
def burn():
    x = 0
    while not stop.is_set():
        x += 1
ts = [threading.Thread(target=burn, daemon=True) for _ in range(8)]
for t in ts: t.start()
time.sleep(0.5)
rows = {"ref": [], "default": []}
for i in range(ROUNDS):
    rows["ref"].append(one(REF, "docs/data/DATA-3694-1.yaml"))
    rows["default"].append(one(None, "docs/data/DATA-3430-1.yaml"))
    print(f"{LABEL} round={i+1} ref={rows['ref'][-1]:.3f} default={rows['default'][-1]:.3f}", flush=True)
stop.set()
for k, v in rows.items():
    print(f"{LABEL} {k} median(2回目以降)={statistics.median(v[1:]):.3f} all={[round(x,3) for x in v]}", flush=True)
